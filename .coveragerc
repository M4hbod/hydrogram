# Coverage is measured on hand-written code only. pyrogram/raw/ and
# pyrogram/errors/exceptions/ are generated by `make api` from the TL schema;
# they are guarded structurally by the round-trip and constructor-ID tests in
# tests/unit/raw/, not by line coverage.
[run]
source = pyrogram
branch = True
omit =
    pyrogram/raw/*
    pyrogram/errors/exceptions/*

[report]
# A ratchet, not an aspiration: set to the measured floor and raised whenever a
# stage adds tests. Never lower it to make a build pass -- that is the one thing
# it exists to prevent. Most of pyrogram/methods/ needs a live client, so the
# realistic ceiling for offline tests is well under 100%.
fail_under = 52
show_missing = True
skip_covered = True
exclude_also =
    if TYPE_CHECKING:
    raise NotImplementedError
    @(abc\.)?abstractmethod
    if __name__ == .__main__.:
